<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Root layout: Anchors the main VBox container to all sides of the window.
  Uses external stylesheet and applies general padding and RTL layout for Hebrew support.
-->
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.suppliq.manufacturepro.Controllers.OrderController"
            styleClass="page-background">

    <!--
      Main container: vertical layout holding the top header and the order table.
      Applies spacing between elements and sets overall RTL layout direction.
    -->
    <VBox fx:id="mainContainer" spacing="15" nodeOrientation="RIGHT_TO_LEFT"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          styleClass="main-container">

        <!--
          Top bar (HBox): Contains the page title, search field, and 'Add Order' button.
          Elements are aligned to the right and spaced evenly.
        -->
        <HBox spacing="20"
              alignment="CENTER_RIGHT"
              nodeOrientation="RIGHT_TO_LEFT"
              styleClass="page-header">

            <!-- Page title -->
            <Label text="📋 ניהול הזמנות" styleClass="page-header-label"/>

            <!-- Flexible spacer pushes content to the sides -->
            <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>

            <!-- Search field for filtering orders by name -->
            <TextField fx:id="searchField" promptText="חפש לפי מס הזמנה..." styleClass="search-field"/>

            <!-- Button for adding a new order -->
            <Button text="➕ הזמנה חדשה" fx:id="addOrderButton" onAction="#addOrder" styleClass="add-button"/>
        </HBox>

        <!--
          Table container (AnchorPane): Holds the order table.
          Fixed height to ensure exactly 10 rows are visible at all times.
        -->
        <AnchorPane fx:id="tableContainer" VBox.vgrow="NEVER">

            <!--
              Order table: Displays a list of orders with 6 columns.
              Fixed height and cell size to limit to 10 visible rows.
            -->
            <TableView fx:id="orderTable" fixedCellSize="40"
                       prefHeight="430"
                       minHeight="430"
                       maxHeight="430"
                       AnchorPane.topAnchor="0"
                       AnchorPane.bottomAnchor="0"
                       AnchorPane.leftAnchor="0"
                       AnchorPane.rightAnchor="0"
                       styleClass="order-table">

                <!-- Table columns for displaying order properties -->
                <columns>
                    <TableColumn fx:id="columnOrderId" text="מס׳ הזמנה"/>
                    <TableColumn fx:id="columnCustomerName" text="לקוח"/>
                    <TableColumn fx:id="columnOrderDate" text="תאריך"/>
                    <TableColumn fx:id="columnStatus" text="סטטוס"/>
                    <TableColumn fx:id="columnTotalAmount" text="סה״כ (₪)"/>
                    <TableColumn fx:id="columnActions" text="פעולות"/>
                </columns>
            </TableView>
        </AnchorPane>
    </VBox>
</AnchorPane>
