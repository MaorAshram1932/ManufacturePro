<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Root layout: Anchors the main VBox container to all sides of the window.
  Uses external stylesheet and applies general padding and RTL layout for Hebrew support.
-->
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.suppliq.manufacturepro.Controllers.CustomerController"
            styleClass="page-background">

    <!--
      Main container: vertical layout holding the top header and the customer table.
      Applies spacing between elements and sets overall RTL layout direction.
    -->
    <VBox fx:id="mainContainer" spacing="15" nodeOrientation="RIGHT_TO_LEFT"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          styleClass="main-container">

        <!--
          Top bar (HBox): Contains the page title, search field, and 'Add Customer' button.
          Elements are aligned to the right and spaced evenly.
        -->
        <HBox spacing="20"
              alignment="CENTER_RIGHT"
              nodeOrientation="RIGHT_TO_LEFT"
              styleClass="page-header">

            <!-- Page title -->
            <Label text="👤 ניהול לקוחות" styleClass="page-header-label"/>

            <!-- Flexible spacer pushes content to the sides -->
            <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>

            <!-- Search field for filtering customers by name -->
            <TextField fx:id="searchField" promptText="חפש לפי שם / אימייל..." styleClass="search-field"/>

            <!-- Button for adding a new customer -->
            <Button text="➕ הוסף לקוח" fx:id="addCustomerButton" onAction="#addCustomer" styleClass="add-button"/>
        </HBox>

        <!--
          Table container (AnchorPane): Holds the customer table.
          Fixed height to ensure exactly 10 rows are visible at all times.
        -->
        <AnchorPane fx:id="tableContainer" VBox.vgrow="NEVER">

            <!--
              Customer table: Displays a list of customers.
              Fixed height and cell size to limit to 10 visible rows.
            -->
            <TableView fx:id="customerTable" fixedCellSize="40"
                       prefHeight="430"
                       minHeight="430"
                       maxHeight="430"
                       AnchorPane.topAnchor="0"
                       AnchorPane.bottomAnchor="0"
                       AnchorPane.leftAnchor="0"
                       AnchorPane.rightAnchor="0"
                       styleClass="customer-table">

                <!-- Table columns for displaying customer properties -->
                <columns>
                    <TableColumn fx:id="columnName" text="שם לקוח"/>
                    <TableColumn fx:id="columnEmail" text="אימייל"/>
                    <TableColumn fx:id="columnPhone" text="טלפון"/>
                    <TableColumn fx:id="columnAddress" text="כתובת"/>
                    <TableColumn fx:id="columnPriceList" text="מחירון"/>
                    <TableColumn fx:id="columnActions" text="פעולות"/>
                </columns>
            </TableView>
        </AnchorPane>
    </VBox>
</AnchorPane>
